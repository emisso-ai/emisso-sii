{
  "name": "@emisso/sii-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @emisso/registry-cl build",
    "test": "pnpm --filter @emisso/registry-cl test",
    "test:run": "pnpm --filter @emisso/registry-cl test:run",
    "lint": "pnpm --filter @emisso/registry-cl lint",
    "test:integration": "tsx scripts/test-auth.ts",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "tsx": "^4.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
